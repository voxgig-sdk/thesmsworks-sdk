# Project overlay — YOURS. The scaffold creates this file once and never
# overwrites it, unlike every other file it writes.
#
# Everything else under model/ is toolchain-derived and is deliberately
# regenerated so that toolchain fixes propagate. Put anything here that is a
# decision about THIS project rather than a fact about the API.
#
# Included LAST by sdk.aon, after target/target-index.aon, because a key
# under main.kit.target.<t> can only refine a target that has already been
# defined. Declared earlier, the model build fails with "Cannot unify value:
# nil with value: string / key ext value was: nil", which names nothing that
# would lead you here.
#
# The release version each generated manifest declares (package.json,
# pyproject.toml, the gemspec, the rockspec) and that the port Makefiles tag:
#
#   main: kit: target: ts: publish: version: '1.2.3'
#
# Per target, because ports publish to different registries on different
# clocks. Set every target to the same value for a lockstep repo.
#
# A published package name that does not follow the derivation:
#
#   main: kit: target: ts: publish: registry: package: '@scope/name'
# All 20 bundled features are carried (core23, Richard 2026-10-01). Every
# feature's model is active by default except secrets, whose source is then
# not emitted while its tests are, so it is switched on here.
main: kit: feature: secrets: active: true
# README prose (sdkgen ReadmeTop reads main.kit.info). Kept here because
# create-sdkgen rewrites config.aontu on every re-scaffold.
main: kit: info: about_md: `**Languages included:** TypeScript, JavaScript, Python, Python Data (pandas), Go, Ruby, Lua, C++, Clojure, Java, Kotlin, OCaml, Swift and Zig, plus a Go CLI and a Go MCP server. Every one of them passes its generated offline test suite.

**Honest state:** generated from The SMS Works public OpenAPI spec on 2026-10-01. Not production-tuned. Known rough edge: the spec names a message field \`from\`, which is a reserved word in Python, so the typed Python model omits it (it is still reachable through the runtime dict). Use it as a starting point or a reference.`

# --- cedar: release version (written by cedar-regen.sh, do not hand-edit)
# Per target, because sdkgen keys the version per target; identical across
# them because cedar tags a repo at one version.
main: kit: target: 'go': publish: version: '0.1.2'
main: kit: target: 'go-cli': publish: version: '0.1.2'
main: kit: target: 'go-mcp': publish: version: '0.1.2'
main: kit: target: 'py': publish: version: '0.1.2'
main: kit: target: 'py-data': publish: version: '0.1.2'
main: kit: target: 'rb': publish: version: '0.1.2'
main: kit: target: 'lua': publish: version: '0.1.2'
main: kit: target: 'cpp': publish: version: '0.1.2'
main: kit: target: 'java': publish: version: '0.1.2'
main: kit: target: 'kotlin': publish: version: '0.1.2'
main: kit: target: 'ocaml': publish: version: '0.1.2'
main: kit: target: 'swift': publish: version: '0.1.2'
main: kit: target: 'zig': publish: version: '0.1.2'
main: kit: target: 'clojure': publish: version: '0.1.2'
main: kit: target: 'ts': publish: version: '0.1.2'
main: kit: target: 'js': publish: version: '0.1.2'
# --- end cedar: release version
