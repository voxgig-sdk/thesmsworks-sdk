# Entity: message

main: kit: entity: message: {

  alias: field: {}

  fields: [
    {
      name: "ai"
      req: false
      short: "Used to determine whether The SMS Works AI Optimiser should be used in the event that the message is just longer than the 1 or 2 credit boundary."
      type: "`$BOOLEAN`"
    }
    {
      name: "content"
      req: true
      short: "Message to send to the recipient."
      type: "`$STRING`"
    }
    {
      name: "credits"
      req: false
      short: "The number of credits used on the message."
      type: "`$NUMBER`"
    }
    {
      name: "deliveryreporturl"
      req: false
      short: "The url to which we should POST delivery reports to for this message."
      type: "`$STRING`"
    }
    {
      name: "destination"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "Telephone number of the recipient"
      type: "`$STRING`"
    }
    {
      name: "from"
      req: false
      short: "The date-time from which you would like matching messages"
      type: "`$STRING`"
    }
    {
      name: "keyword"
      req: false
      short: "The keyword used in the inbound message"
      type: "`$STRING`"
    }
    {
      name: "limit"
      req: false
      short: "The maximum number of messages that you would like returned in this call."
      type: "`$NUMBER`"
    }
    {
      name: "metadata"
      req: false
      short: "An array of objects containing metadata key/value pairs that have been saved on messages."
      type: "`$OBJECT`"
    }
    {
      name: "responseemail"
      req: false
      short: "An optional list of email addresses to forward responses to this specific message to."
      type: "`$ARRAY`"
    }
    {
      name: "schedule"
      req: false
      short: "Date at which to send the message."
      type: "`$STRING`"
    }
    {
      name: "sender"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "The sender of the message."
      type: "`$STRING`"
    }
    {
      name: "skip"
      req: false
      short: "The number of results you would like to ignore before returning messages."
      type: "`$NUMBER`"
    }
    {
      name: "status"
      req: false
      short: "The status of the messages you would like returned (either 'SENT', 'DELIVERED', 'EXPIRED', 'UNDELIVERABLE', 'REJECTED' or 'INCOMING')"
      type: "`$STRING`"
    }
    {
      name: "tag"
      req: false
      short: "An identifying label for the message, which you can use to filter and report on messages you've sent later."
      type: "`$STRING`"
    }
    {
      name: "to"
      req: false
      short: "The date-time to which you would like matching messages"
      type: "`$STRING`"
    }
    {
      name: "ttl"
      req: false
      short: "The optional number of minutes before the delivery report is deleted."
      type: "`$NUMBER`"
    }
    {
      name: "unread"
      req: false
      short: "In queries for incoming messages ('status' is 'INCOMING'), specify whether you explicitly want unread messages (true) or read messages (false)."
      type: "`$BOOLEAN`"
    }
    {
      name: "validity"
      req: false
      short: "The optional number of minutes to attempt delivery before the message is marked as EXPIRED."
      type: "`$NUMBER`"
    }
  ]

  name: "message"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/message/flash"
          parts: [
            "message"
            "flash"
          ]
          select: {
            "$action": "flash"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/message/schedule"
          parts: [
            "message"
            "schedule"
          ]
          select: {
            "$action": "schedule"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/message/send"
          parts: [
            "message"
            "send"
          ]
          select: {
            "$action": "send"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/messages"
          parts: [
            "messages"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/messages/failed"
          parts: [
            "messages"
            "failed"
          ]
          select: {
            "$action": "failed"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "POST"
          orig: "/messages/inbox"
          parts: [
            "messages"
            "inbox"
          ]
          select: {
            "$action": "inbox"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "messageid"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/messages/{messageid}"
          parts: [
            "messages"
            "{id}"
          ]
          rename: {
            param: {
              messageid: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/messages/schedule"
          parts: [
            "messages"
            "schedule"
          ]
          select: {
            "$action": "schedule"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "messageid"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/messages/{messageid}"
          parts: [
            "messages"
            "{id}"
          ]
          rename: {
            param: {
              messageid: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          args: {
            params: [
              {
                kind: "param"
                name: "messageid"
                orig: "messageid"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "DELETE"
          orig: "/messages/schedule/{messageid}"
          parts: [
            "messages"
            "schedule"
            "{messageid}"
          ]
          select: {
            exist: [
              "messageid"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "schedule"
      ]
    ]
  }



}
