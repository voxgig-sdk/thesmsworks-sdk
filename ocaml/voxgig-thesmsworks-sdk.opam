opam-version: "2.0"
name: "voxgig-thesmsworks-sdk"
version: "0.1.2"
synopsis: "Thesmsworks SDK for OCaml (generated by @voxgig/sdkgen)"
maintainer: "Voxgig"
authors: "Voxgig"
license: "MIT"
homepage: "https://github.com/voxgig-sdk/thesmsworks-sdk"
bug-reports: "https://github.com/voxgig-sdk/thesmsworks-sdk/issues"
# The generated SDK is dependency-free: it compiles with the stock ocamlc
# (see the Makefile). No opam packages, no dune.
depends: [
  "ocaml" {>= "4.14"}
]
build: [
  [make "build"]
]
